NODE_ENV=development
PORT=8080
# SECURITY WARNING: Never put your hosted production address and password in this file.
DATABASE_URL=your_database_url
ACCESS_TOKEN_SECRET=your_access_token_secret
REFRESH_TOKEN_SECRET=your_refresh_token_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
COOKIE_SECURE=false
CLIENT_ORIGIN=http://localhost:5173
# TEST_DATABASE_URL: Local Docker PostgreSQL connection string (obtain from `npx supabase status`)
# TESTING POLICY: Tests run only against a local address. Never use a hosted address for testing.
TEST_DATABASE_URL=your_test_database_url
